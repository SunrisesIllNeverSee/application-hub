{
  "artifact": "03_transformation_registry",
  "transformations": [
    {
      "id": "T01",
      "name": "manual_intake_extract",
      "input": "raw intake payload",
      "output": [
        "intake_submissions",
        "intake_entities",
        "intake_applications",
        "intake_application_layers",
        "intake_questions"
      ],
      "function_or_route": "POST /api/hub/ingest -> extractManualIntake",
      "phase_change": "raw_source_to_staged_structure",
      "loss_profile": "potentially lossy extraction; raw_input retained",
      "reversible": "partially",
      "validation_gate": "entity_checkpoint",
      "observed": true
    },
    {
      "id": "T02",
      "name": "checkpoint_review",
      "input": "staged intake layer",
      "output": "approved/rejected/needs_revision staged layer + intake_gate_reviews + intake_events",
      "function_or_route": "POST /api/hub/intake/review",
      "phase_change": "candidate_to_human_validated",
      "loss_profile": "edits alter structured representation; event captures workflow state and edited payload",
      "reversible": "historically reconstructable where payload_before/after is complete",
      "validation_gate": "human",
      "observed": true
    },
    {
      "id": "T03",
      "name": "question_normalization",
      "input": "program-specific question wording",
      "output": "archived_questions + program_questions",
      "function_or_route": "schema/import/matching pipeline",
      "phase_change": "question_occurrence_to_normalized_question",
      "loss_profile": "exact asked_as preserved in program_questions; normalization may collapse semantic distinctions",
      "reversible": "yes to occurrence wording if program_questions exists",
      "validation_gate": "none identified globally",
      "observed": true
    },
    {
      "id": "T04",
      "name": "profile_to_application_answer",
      "input": "profile_answers",
      "output": "application_answers",
      "function_or_route": "application creation/save workflow",
      "phase_change": "reusable_answer_to_application_specific_answer",
      "loss_profile": "application context may diverge after refinement; source marker exists in design",
      "reversible": "partially",
      "validation_gate": "user edit",
      "observed": true
    },
    {
      "id": "T05",
      "name": "canonical_ingest_extract_commitments",
      "input": "content or explicit commitments",
      "output": "canonical_commitments",
      "function_or_route": "canonical-hub handleIngest/extractCommitments/findOrCreateCanonical",
      "phase_change": "prose_or_commitments_to_portable_canonical",
      "loss_profile": "high-risk if using placeholder sentence/chunk extraction; canonicalization can merge or split claims",
      "reversible": "no",
      "validation_gate": "not required in canonical edge function",
      "observed": true,
      "algorithm_status": "placeholder in code"
    },
    {
      "id": "T06",
      "name": "canonical_map_variant",
      "input": "user commitment content + canonical",
      "output": "answer_variants + lineage_events",
      "function_or_route": "canonical-hub handleIngest / handleMapVariant",
      "phase_change": "user_expression_to_canonical_spoke",
      "loss_profile": "content preserved; fidelity is derived",
      "reversible": "yes for content",
      "validation_gate": "none",
      "observed": true,
      "algorithm_status": "placeholder fidelity formula"
    },
    {
      "id": "T07",
      "name": "package_assembly",
      "input": "canonical IDs + variant IDs",
      "output": "application_packages + lineage_events",
      "function_or_route": "canonical-hub handleIngest",
      "phase_change": "individual_commitments_to_application_package",
      "loss_profile": "soft JSON IDs create weaker referential integrity than FKs",
      "reversible": "yes if referenced objects remain",
      "validation_gate": "none",
      "observed": true
    },
    {
      "id": "T08",
      "name": "semantic_canonical_search",
      "input": "768d query embedding",
      "output": "ranked canonical commitments",
      "function_or_route": "semantic_search_canonicals",
      "phase_change": "query_to_ranked_candidates",
      "loss_profile": "ranking projection discards nonreturned candidates",
      "reversible": "no",
      "validation_gate": "threshold 0.55 default",
      "observed": true
    },
    {
      "id": "T09",
      "name": "hybrid_canonical_search",
      "input": "text + optional embedding + vertical",
      "output": "ranked canonical commitments with fidelity_potential",
      "function_or_route": "search_canonicals_hybrid",
      "phase_change": "query_to_ranked_candidates",
      "loss_profile": "weighted score compresses vector/text/significance signals",
      "reversible": "no",
      "validation_gate": "ranking only",
      "observed": true
    },
    {
      "id": "T10",
      "name": "smart_matcher",
      "input": "user persona + answer_variants + program/canonical signals",
      "output": "ranked programs",
      "function_or_route": "smart-matcher edge + smart_matcher_search RPC",
      "phase_change": "knowledge_state_to_opportunity_ranking",
      "loss_profile": "many features compressed to scalar fit score and snippet",
      "reversible": "no",
      "validation_gate": "none",
      "observed": true
    },
    {
      "id": "T11",
      "name": "canonical_package_export",
      "input": "application_package/canonical IDs",
      "output": "JSON/Markdown/PDF-ready envelope",
      "function_or_route": "canonical-hub handleExport + get_canonical_package",
      "phase_change": "internal_graph_to_portable_export",
      "loss_profile": "depends on export format; lineage flag preserved in envelope",
      "reversible": "JSON mostly; Markdown less so",
      "validation_gate": "auth/user scope",
      "observed": true
    },
    {
      "id": "T12",
      "name": "answer_review_and_stress_test",
      "input": "answer text + context",
      "output": [
        "answer_reviews",
        "answer_stress_tests"
      ],
      "function_or_route": "MCP/API answer review and stress-test tools",
      "phase_change": "answer_to_evaluated_answer",
      "loss_profile": "evaluation is derived; source answer remains elsewhere",
      "reversible": "not applicable",
      "validation_gate": "user/tool invocation",
      "observed": true
    }
  ],
