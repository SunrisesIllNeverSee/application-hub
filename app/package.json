    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "^20",
    "@types/react": "^18",
