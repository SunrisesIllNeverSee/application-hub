{
  "name": "aqua-mcp-server",
  "version": "2.0.3",
  "description": "MCP server for the AQUA Application Hub: the AQUA companion's tiered tools on a local encrypted workspace, plus read-only public catalog tools. No account token, no privileged key.",
  "type": "module",
  "bin": {
    "aqua-mcp-server": "bin/aqua-mcp-server.mjs"
  },
  "exports": {
    ".": "./src/catalog/index.mjs",
    "./catalog": "./src/catalog/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "TOOLS.json",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/aqua-mcp-server.mjs",
    "test": "node --test test/*.test.mjs",
    "manifest": "node scripts/gen-tools.mjs",
    "manifest:check": "node scripts/gen-tools.mjs --check",
    "vendor:hosted": "node scripts/vendor-hosted.mjs",
    "vendor:hosted:check": "node scripts/vendor-hosted.mjs --check",
    "live-check": "node scripts/live-check.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node bin/aqua-mcp-server.mjs",
    "vendor:companion": "node scripts/vendor-companion.mjs",
    "vendor:companion:check": "node scripts/vendor-companion.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aqua",
    "application-hub",
    "agent",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SunrisesIllNeverSee/application-hub.git",
    "directory": "application-hub-mcp-server"
  },
  "homepage": "https://aquaidp.xyz/mcp",
  "bugs": {
    "url": "https://github.com/SunrisesIllNeverSee/application-hub/issues"
  },
  "license": "MIT",
  "dependencies": {}
}
